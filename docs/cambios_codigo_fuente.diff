+        java.util.Map<String, String> pathVars = new java.util.HashMap<>();
+        String expectedProcessor = (processorParam != null) ? processorParam : ApiConstants.PROCESSOR_SOAP;
+        pathVars.put(ApiConstants.TYPE_JOB, expectedProcessor);
