diff --git a/src/test/java/com/example/fileprocessor/domain/exception/ProcessingExceptionTest.java b/src/test/java/com/example/fileprocessor/domain/exception/ProcessingExceptionTest.java
new file mode 100644
index 0000000..8234096
--- /dev/null
